# Frontend configuration.
#
# Both values are inlined into the client bundle at build time (that is what
# the NEXT_PUBLIC_ prefix means), so neither may hold a secret. The frontend
# never handles a JWT: auth cookies are set by the API and carried by the
# browser, so there is no token to configure here.

# Origin of the Express API. Must be an origin the API lists in its own
# FRONTEND_ORIGIN, since auth requests are credentialed and CORS will reject
# a mismatch.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this site. Used for canonical URLs, Open Graph tags, the
# sitemap, and JSON-LD @id values — all of which need an absolute URL, so this
# must be the real origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox token for rendering the location picker's map.
#
# This one is inlined into the bundle and therefore readable by anyone, so it
# must be a *separate*, URL-restricted public token — never the secret
# MAPBOX_TOKEN the API uses for geocoding. Restrict it to your origins in the
# Mapbox dashboard; that URL restriction is the only thing standing between a
# public token and someone else's map bill.
#
# Without it the picker shows a setup message and the landlord can still save
# the listing; only the map itself is unavailable.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Origin listing photos are served from — the API's S3_ENDPOINT, not its bucket
# path. `next/image` refuses any remote host it was not told about, so this has
# to match or every listing photo fails to load. Not NEXT_PUBLIC_: it is read in
# next.config.ts at build time and never needed in the browser.
MEDIA_ORIGIN=http://localhost:9000
