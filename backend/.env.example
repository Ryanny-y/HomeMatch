# Backend configuration.
#
# `src/shared/config/env.ts` parses this with Zod at import time and throws on
# anything missing, so the API refuses to start rather than failing later in a
# request. Copy to `.env` and fill in. Never commit the filled copy.

# --- Core ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Postgres. Port 5433, not 5432 — docker-compose.yml deliberately avoids the
# default so this project's database can coexist with others on one machine.
DATABASE_URL=postgresql://homematch:homematch_dev_password@localhost:5433/homematch

# Comma-separated allowlist for CORS. `*` is rejected outright: auth requests
# carry a session cookie, and browsers refuse credentialed requests to a
# wildcard origin.
FRONTEND_ORIGIN=http://localhost:3000

# The single canonical origin used to build links in outbound email. Separate
# from FRONTEND_ORIGIN, which is a list and cannot be concatenated into a URL.
PUBLIC_APP_URL=http://localhost:3000

# --- Auth ---------------------------------------------------------------------

# HS256 signing key. At least 32 characters — shorter keys are silently accepted
# by the algorithm and quietly weaken every token, so they are rejected instead.
# Generate one: openssl rand -base64 48
JWT_SECRET=

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# --- Email --------------------------------------------------------------------
#
# Required in production, optional here: without a key the app falls back to a
# mailer that logs the verification link, which is more useful locally than a
# real send. Do not use an `@resend.dev` sender in production — it only delivers
# to the Resend account owner, so real signups would silently receive nothing.

RESEND_API_KEY=
MAIL_FROM=

# --- Geocoding ----------------------------------------------------------------
#
# Mapbox token for turning a typed address into coordinates. Server-side because
# geocoding is billed per call and a token in the browser is a token anyone can
# spend — keep this one secret and give the frontend a separate, URL-restricted
# public token.
#
# Optional everywhere: without it the address lookup returns a clear error and
# the landlord places the map pin by hand.
MAPBOX_TOKEN=

# --- Object storage -----------------------------------------------------------
#
# MinIO locally, S3 or R2 in production — only endpoint and credentials differ.
# S3_FORCE_PATH_STYLE must stay true for MinIO, which has no per-bucket DNS.

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=homematch-dev
S3_ACCESS_KEY_ID=homematch
S3_SECRET_ACCESS_KEY=homematch_dev_password
S3_FORCE_PATH_STYLE=true

# --- Misc ---------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Consumed only by prisma/seed.ts. Kept out of code because an admin credential
# in git is the worst kind of secret to leak.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
