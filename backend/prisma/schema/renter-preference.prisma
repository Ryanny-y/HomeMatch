/// Every value maps 1:1 to a Listing column, so adding one here means adding
/// the listing field in the same change — a want nothing can be compared
/// against is unscorable.
enum RenterWant {
  pets
  parking
  own_bathroom
  furnished
  near_transit
  aircon
}


model RenterPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  budget Decimal? @db.Decimal(12, 2)

  householdSize Int?

  wants RenterWant[]

  otherNeeds String? @db.VarChar(500)

  /// Where the renter will live, structured so it can drive a SQL filter.
  ///
  /// This does not replace the location wants inside `otherNeeds` — "near UP
  /// Diliman" is richer than any list and stays where a later extraction step
  /// can read it. But prose cannot be a `WHERE` clause, and the catalog filter
  /// needs one. Two fields, two jobs.
  ///
  /// Plural because a renter realistically accepts several areas; a single
  /// barangay makes the default filter narrow enough that they would just clear
  /// it. Values are the free-text strings stored on `Listing.barangay`, which is
  /// why the picker offers only barangays that published listings actually use.
  preferredCity      String?
  preferredBarangays String[]

  /// Set when onboarding is completed **or skipped**, which is why it is not
  /// inferred from the other columns: a renter who deliberately skipped has an
  /// empty profile, and without this they would be sent back every login.
  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("renter_preferences")
}
