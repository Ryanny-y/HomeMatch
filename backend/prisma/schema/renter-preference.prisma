/// Every value maps 1:1 to a Listing column, so adding one here means adding
/// the listing field in the same change — a want nothing can be compared
/// against is unscorable.
enum RenterWant {
  pets
  parking
  own_bathroom
  furnished
  near_transit
  aircon
}


model RenterPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  budget Decimal? @db.Decimal(12, 2)

  householdSize Int?

  wants RenterWant[]

  otherNeeds String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("renter_preferences")
}
